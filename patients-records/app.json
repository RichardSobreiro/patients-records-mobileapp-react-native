{
  "expo": {
    "name": "Portal Atender",
    "description": "A plataforma que ajuda você a gerenciar seus atendimentos por um preço justo.",
    "slug": "patients-records",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": ["com.sobreirostechnologies.patientsrecords", "fb592502122839259"],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0ec3"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "buildNumber": "1.0.2",
      "supportsTablet": true,
      "bundleIdentifier": "com.sobreirostechnologies.patientsrecords"
    },
    "android": {
      "package": "com.sobreirostechnologies.patientsrecords",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "29bd022f-4e58-4283-8160-3a2bdbbdc380"
      }
    },
    "plugins": [
      [
        "expo-updates",
        {
          "username": "RichardSobreiro"
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "O applicativo acessa sua galeria para gerenciar as fotos do antes e depois de seus pacientes."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/29bd022f-4e58-4283-8160-3a2bdbbdc380"
    }
  }
